# ============================================
# SemanticRAG Configuration (.env)
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# --- LLM Configuration ---
# Model to use: mistral-large-latest | qwen-2.5-32b
LLM_MODEL=mistral-large-latest

# Mistral AI API Key
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# (Optional) Qwen API Key if using Qwen model
# QWEN_API_KEY=your_qwen_api_key_here

# --- Execution Parameters ---
# Batch size for parallel processing (1-64, lower = slower but more reliable)
BATCH_SIZE=4

# Retry strategy for API calls: standard | rate-limit-drain | micro-batch-recovery
RETRY_PROFILE=micro-batch-recovery

# Max retries for failed API calls
MAX_RETRIES=5

# Timeout for API calls (seconds)
API_TIMEOUT=60

# --- GraphDB Configuration ---
# (Optional - only if you want to publish to GraphDB)
GRAPHDB_ENDPOINT=http://localhost:7200
GRAPHDB_REPOSITORY=default
GRAPHDB_USERNAME=admin
GRAPHDB_PASSWORD=

# --- Data Paths ---
# Base directory for input manuals (relative to project root)
DATA_INPUT_DIR=data/input

# Directory for processed artifacts
DATA_PROCESSED_DIR=data/processed

# Directory for golden sets (evaluation datasets)
DATA_GOLDEN_SETS_DIR=data/golden_sets

# Cache directory
DATA_CACHE_DIR=data/cache

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/semantic_rag.log

# --- Feature Flags ---
# Enable multilinguality support (ES/EN)
ENABLE_MULTILINGUAL=true

# Enable AAS projection
ENABLE_AAS_PROJECTION=false

# Enable GraphDB publication (if configured)
ENABLE_GRAPHDB_PUBLICATION=false

# --- Advanced ---
# Run in verbose mode
VERBOSE=false

# Temporary directory for intermediate files
TEMP_DIR=.tmp

# --- Project-Specific (Optional) ---
# Reference project name (for reference data)
REFERENCE_PROJECT=broaching-cnc-8070

# Default manual ID for builds
DEFAULT_MANUAL_ID=
